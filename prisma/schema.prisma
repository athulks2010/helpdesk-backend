generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Role {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  name       String?   @db.VarChar(255)
  slug       String?   @db.VarChar(255)
  access     Json?
  created_at DateTime? @default(now()) @db.DateTime(0)
  updated_at DateTime? @updatedAt @db.DateTime(0)

  users      User[]

  @@map("roles")
}

model User {
  id                BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  first_name        String?   @db.VarChar(255)
  last_name         String?   @db.VarChar(255)
  email             String    @unique @db.VarChar(255)
  password          String?   @db.VarChar(255)
  locale            String?   @default("en") @db.VarChar(255)
  role_id           BigInt?   @db.UnsignedBigInt
  phone             String?   @db.VarChar(255)
  city              String?   @db.VarChar(255)
  address           String?   @db.Text
  country_id        BigInt?   @db.UnsignedBigInt
  title             String?   @db.VarChar(255)
  photo_path        String?   @db.VarChar(255)
  remember_token    String?   @db.VarChar(255)
  email_verified_at DateTime? @db.DateTime(0)
  created_at        DateTime? @default(now()) @db.DateTime(0)
  updated_at        DateTime? @updatedAt @db.DateTime(0)
  role              Role?     @relation(fields: [role_id], references: [id], onDelete: SetNull)

  @@index([role_id])
  @@index([country_id])
  @@map("users")
}

model PendingUser {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  first_name String?   @db.VarChar(255)
  last_name  String?   @db.VarChar(255)
  email      String?   @db.VarChar(255)
  password   String?   @db.VarChar(255)
  role_id    BigInt?   @db.UnsignedBigInt
  created_at DateTime? @default(now()) @db.DateTime(0)
  updated_at DateTime? @updatedAt @db.DateTime(0)


  @@map("pending_users")
}

model PersonalAccessToken {
  id             BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  tokenable_type String?   @db.VarChar(255)
  tokenable_id   BigInt?   @db.UnsignedBigInt
  name           String?   @db.VarChar(255)
  token          String?   @unique @db.VarChar(64)
  abilities      String?   @db.Text
  last_used_at   DateTime? @db.DateTime(0)
  expires_at     DateTime? @db.DateTime(0)
  created_at     DateTime? @default(now()) @db.DateTime(0)
  updated_at     DateTime? @updatedAt @db.DateTime(0)

  @@index([tokenable_type, tokenable_id])
  @@map("personal_access_tokens")
}

model PasswordReset {
  email      String    @id @db.VarChar(255)
  token      String?   @db.VarChar(255)
  created_at DateTime? @db.DateTime(0)

  @@map("password_resets")
}

model Country {
  id   BigInt  @id @default(autoincrement()) @db.UnsignedBigInt
  code String  @db.VarChar(2)
  name String  @db.VarChar(75)

  @@index([code])
  @@map("countries")
}

model Organization {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  name       String?   @db.VarChar(100)
  email      String?   @db.VarChar(50)
  phone      String?   @db.VarChar(50)
  address    String?   @db.VarChar(150)
  city       String?   @db.VarChar(50)
  region     String?   @db.VarChar(50)
  country    String?   @db.VarChar(2)
  postal_code String?  @db.VarChar(25)
  created_at DateTime? @default(now()) @db.DateTime(0)
  updated_at DateTime? @updatedAt @db.DateTime(0)

  @@map("organizations")
}

model Contact {
  id              BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  organization_id BigInt?   @db.UnsignedBigInt
  first_name      String?   @db.VarChar(25)
  last_name       String?   @db.VarChar(25)
  email           String    @db.VarChar(50)
  phone           String?   @db.VarChar(50)
  address         String?   @db.VarChar(150)
  city            String?   @db.VarChar(50)
  region          String?   @db.VarChar(50)
  country         String?   @db.VarChar(2)
  postal_code     String?   @db.VarChar(25)
  created_at      DateTime? @default(now()) @db.DateTime(0)
  updated_at      DateTime? @updatedAt @db.DateTime(0)

  @@map("contacts")
}

model Status {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  name       String?   @db.VarChar(255)
  slug       String?   @db.VarChar(255)
  color      String?   @db.VarChar(255)
  created_at DateTime? @default(now()) @db.DateTime(0)
  updated_at DateTime? @updatedAt @db.DateTime(0)


  @@map("status")
}

model Priority {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  name       String?   @db.VarChar(255)
  color      String?   @db.VarChar(255)
  created_at DateTime? @default(now()) @db.DateTime(0)
  updated_at DateTime? @updatedAt @db.DateTime(0)


  @@map("priorities")
}

model Department {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  name       String?   @db.VarChar(255)
  created_at DateTime? @default(now()) @db.DateTime(0)
  updated_at DateTime? @updatedAt @db.DateTime(0)


  @@map("departments")
}

model Type {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  name       String?   @db.VarChar(255)
  slug       String?   @db.VarChar(255)
  created_at DateTime? @default(now()) @db.DateTime(0)
  updated_at DateTime? @updatedAt @db.DateTime(0)


  @@map("types")
}

model Category {
  id            BigInt  @id @default(autoincrement()) @db.UnsignedBigInt
  name          String? @db.VarChar(50)
  department_id BigInt? @db.UnsignedBigInt
  parent_id     BigInt? @db.UnsignedBigInt
  color         String? @db.VarChar(20)

  @@map("categories")
}

model Ticket {
  id                BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  uid               String?   @db.VarChar(100)
  subject           String    @db.VarChar(250)
  details           String    @db.Text
  user_id           BigInt?   @db.UnsignedBigInt
  contact_id        BigInt?   @db.UnsignedBigInt
  status_id         BigInt?   @db.UnsignedBigInt
  priority_id       BigInt?   @db.UnsignedBigInt
  department_id     BigInt?   @db.UnsignedBigInt
  type_id           BigInt?   @db.UnsignedBigInt
  category_id       BigInt?   @db.UnsignedBigInt
  sub_category_id   BigInt?   @db.UnsignedBigInt
  assigned_to       BigInt?   @db.UnsignedBigInt
  created_by        String?   @db.VarChar(50)
  parent_id         BigInt?   @db.UnsignedBigInt
  parent_ticket_id  BigInt?   @db.UnsignedBigInt
  template_id       BigInt?   @db.UnsignedBigInt
  open              DateTime? @db.DateTime(0)
  due               DateTime? @db.DateTime(0)
  close             DateTime? @db.DateTime(0)
  response          DateTime? @db.DateTime(0)
  impact_level      String?   @db.VarChar(20)
  urgency_level     String?   @db.VarChar(20)
  sla_policy_id     BigInt?   @db.UnsignedBigInt
  created_at        DateTime? @default(now()) @db.DateTime(0)
  updated_at        DateTime? @updatedAt @db.DateTime(0)

  @@map("tickets")
}

model Comment {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  details    String?   @db.Text
  ticket_id  BigInt?   @db.UnsignedBigInt
  user_id    BigInt?   @db.UnsignedBigInt
  contact_id BigInt?   @db.UnsignedBigInt
  created_at DateTime? @default(now()) @db.DateTime(0)
  updated_at DateTime? @updatedAt @db.DateTime(0)

  @@map("comments")
}

model Attachment {
  id              BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  ticket_id       BigInt?   @db.UnsignedBigInt
  conversation_id BigInt?   @db.UnsignedBigInt
  user_id         BigInt?   @db.UnsignedBigInt
  name            String?   @db.VarChar(255)
  path            String?   @db.VarChar(255)
  mime            String?   @db.VarChar(255)
  size            Int?
  created_at      DateTime? @default(now()) @db.DateTime(0)
  updated_at      DateTime? @updatedAt @db.DateTime(0)


  @@map("attachments")
}

model Conversation {
  id              BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  title           String?   @db.VarChar(100)
  status          String    @default("active") @db.VarChar(20)
  last_message_at DateTime? @db.DateTime(0)
  priority        String    @default("medium") @db.VarChar(20)
  department      String    @default("general") @db.VarChar(50)
  source          String    @default("website") @db.VarChar(50)
  metadata        Json?
  last_activity   DateTime? @db.DateTime(0)
  contact_id      Int?      @db.UnsignedInt
  ticket_id       Int?      @db.UnsignedInt
  type            String    @default("internal") @db.VarChar(20)
  created_by      Int?      @db.UnsignedInt
  context         Json?
  slug            String?   @db.VarChar(100)
  created_at      DateTime? @default(now()) @db.DateTime(0)
  updated_at      DateTime? @updatedAt @db.DateTime(0)

  @@map("conversations")
}

model Message {
  id              BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  guid            Int?
  conversation_id Int
  user_id         Int?
  contact_id      Int?
  is_read         Int       @default(0)
  is_internal     Boolean   @default(false)
  read_at         DateTime? @db.DateTime(0)
  message         String    @db.Text
  message_type    String    @default("text") @db.VarChar(20)
  created_at      DateTime? @default(now()) @db.DateTime(0)
  updated_at      DateTime? @updatedAt @db.DateTime(0)

  @@map("messages")
}

model Participant {
  id              Int       @id @default(autoincrement()) @db.UnsignedInt
  conversation_id Int
  user_id         Int?
  contact_id      Int?
  role            String    @default("participant") @db.VarChar(255)
  joined_at       DateTime? @db.DateTime(0)
  created_at      DateTime? @default(now()) @db.DateTime(0)
  updated_at      DateTime? @updatedAt @db.DateTime(0)

  @@map("participants")
}

model MessageAttachment {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  message_id Int       @db.UnsignedInt
  filename   String    @db.VarChar(255)
  file_path  String    @db.VarChar(255)
  file_size  BigInt
  mime_type  String    @db.VarChar(255)
  created_at DateTime? @default(now()) @db.DateTime(0)
  updated_at DateTime? @updatedAt @db.DateTime(0)

  @@map("message_attachments")
}

model Notification {
  id              String    @id @db.VarChar(255)
  type            String?   @db.VarChar(255)
  notifiable_type String?   @db.VarChar(255)
  notifiable_id   BigInt?   @db.UnsignedBigInt
  data            String?   @db.Text
  read_at         DateTime? @db.DateTime(0)
  created_at      DateTime? @default(now()) @db.DateTime(0)

  @@index([notifiable_type, notifiable_id])
  @@map("notifications")
}

model Setting {
  id    BigInt  @id @default(autoincrement()) @db.UnsignedBigInt
  name  String? @db.VarChar(255)
  slug  String? @db.VarChar(255)
  type  String? @db.VarChar(255)
  value String? @db.Text

  @@map("settings")
}

model Faq {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  name       String?   @db.VarChar(150)
  details    String?   @db.Text
  status     Int       @default(1)
  created_at DateTime? @default(now()) @db.DateTime(0)
  updated_at DateTime? @updatedAt @db.DateTime(0)

  @@map("faqs")
}

model Post {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  title      String    @db.VarChar(255)
  details    String?   @db.Text
  type_id    BigInt?   @db.UnsignedBigInt
  author_id  BigInt?   @db.UnsignedBigInt
  image      String?   @db.VarChar(250)
  is_active  Int       @default(1)
  created_at DateTime? @default(now()) @db.DateTime(0)
  updated_at DateTime? @updatedAt @db.DateTime(0)

  @@map("posts")
}

model KnowledgeBase {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  title      String    @db.VarChar(255)
  details    String?   @db.Text
  type_id    BigInt?   @db.UnsignedBigInt
  created_at DateTime? @default(now()) @db.DateTime(0)
  updated_at DateTime? @updatedAt @db.DateTime(0)

  @@map("knowledge_base")
}

model EmailTemplate {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  name       String?   @db.VarChar(255)
  subject    String?   @db.VarChar(255)
  body       String?   @db.LongText
  slug       String?   @db.VarChar(255)
  details    String?   @db.VarChar(255)
  language   String?   @default("en") @db.VarChar(10)
  created_at DateTime? @default(now()) @db.DateTime(0)
  updated_at DateTime? @updatedAt @db.DateTime(0)

  @@map("email_templates")
}

model Language {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  name       String?   @db.VarChar(255)
  code       String?   @db.VarChar(255)
  flag       String?   @db.VarChar(255)
  is_default Boolean?
  created_at DateTime? @default(now()) @db.DateTime(0)
  updated_at DateTime? @updatedAt @db.DateTime(0)


  @@map("languages")
}

model Note {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  user_id    BigInt?   @db.UnsignedBigInt
  name       String?   @db.VarChar(100)
  details    String?   @db.Text
  color      String?   @db.VarChar(255)
  created_at DateTime? @default(now()) @db.DateTime(0)
  updated_at DateTime? @updatedAt @db.DateTime(0)

  @@map("notes")
}

model Service {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  title      String    @db.VarChar(255)
  slug       String    @unique @db.VarChar(255)
  icon       String?   @db.VarChar(80)
  author_id  BigInt?   @db.UnsignedBigInt
  is_active  Int       @default(1)
  image      String?   @db.VarChar(250)
  details    String?   @db.Text
  created_at DateTime? @default(now()) @db.DateTime(0)
  updated_at DateTime? @updatedAt @db.DateTime(0)

  @@map("services")
}

model FrontPage {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  title      String?   @db.VarChar(150)
  slug       String?   @db.VarChar(50)
  is_active  Int?      @default(1)
  html       Json?
  created_at DateTime? @default(now()) @db.DateTime(0)
  updated_at DateTime? @updatedAt @db.DateTime(0)

  @@map("front_pages")
}

model NavigationMenu {
  id           BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  location     String    @default("header") @db.VarChar(32)
  label        String    @db.VarChar(255)
  route_name   String?   @db.VarChar(255)
  route_params Json?
  url          String?   @db.VarChar(255)
  icon         String?   @db.VarChar(255)
  active_key   String?   @db.VarChar(255)
  feature_slug String?   @db.VarChar(255)
  target       String    @default("_self") @db.VarChar(16)
  sort_order   Int       @default(0) @db.UnsignedInt
  is_active    Boolean   @default(true)
  created_at   DateTime? @default(now()) @db.DateTime(0)
  updated_at   DateTime? @updatedAt @db.DateTime(0)

  @@map("navigation_menus")
}

model MediaFolder {
  id         BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  name       String        @db.VarChar(255)
  parent_id  BigInt?       @db.UnsignedBigInt
  created_at DateTime?     @default(now()) @db.DateTime(0)
  updated_at DateTime?     @updatedAt @db.DateTime(0)
  parent     MediaFolder?  @relation("MediaFolderTree", fields: [parent_id], references: [id], onDelete: Cascade)
  children   MediaFolder[] @relation("MediaFolderTree")

  @@map("media_folders")
}
